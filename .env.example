# Copy to .env and fill in. Never commit .env.

# --- Supabase URL (Auth / API) ---
# Default while on the free project URL:
#   EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#
# After claiming vanity subdomain bootwatch.supabase.co (paid org + Supabase CLI):
#   EXPO_PUBLIC_SUPABASE_URL=https://bootwatch.supabase.co
# Vanity and “custom domain on your own DNS” are mutually exclusive on Supabase.
#
# Setup checklist for bootwatch.supabase.co:
# 1) Org on a paid plan (Pro/Team/Enterprise) — vanity is not available on Free.
# 2) Google Cloud → APIs & Services → Credentials → your OAuth Web client → Authorized redirect URIs:
#    add https://bootwatch.supabase.co/auth/v1/callback (keep the old …/auth/v1/callback until cutover if you want).
# 3) npx supabase login
# 4) npm run supabase:vanity:check -- --project-ref <YOUR_PROJECT_REF>
# 5) npm run supabase:vanity:activate -- --project-ref <YOUR_PROJECT_REF>
# 6) Set EXPO_PUBLIC_SUPABASE_URL=https://bootwatch.supabase.co here and in EAS → Project → Secrets (same for preview if used).
# Docs: https://supabase.com/docs/guides/platform/custom-domains#vanity-subdomains
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Android release: Maps SDK key (also add as EAS Secret GOOGLE_MAPS_API_KEY for production builds).
# Enable "Maps SDK for Android" in Google Cloud Console for this key.
# GOOGLE_MAPS_API_KEY=

# Optional: timer raccoon mascot (see docs/FEATURE_FLAGS.md)
# 1 = always show, 0 = always hide, omit = dev only
# EXPO_PUBLIC_SHOW_MASCOT=1

# --- Store builds (EAS) ---
# 1) npm i -g eas-cli   OR   npx eas-cli@latest login
# 2) npx eas-cli@latest init    (links project; writes expo.extra.eas.projectId into app.json)
# 3) Expo dashboard → Project → Secrets: EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_ANON_KEY,
#    GOOGLE_MAPS_API_KEY (Android map tiles in release)
# 4) npm run build:ios && npm run build:android   (or build:all)
# 5) TestFlight / Play internal testing, then: npm run submit:ios / submit:android
